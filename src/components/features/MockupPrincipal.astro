---
/*
interface Props {
  name: string;
  title: string;
  descriptioon: string;
  details: string;
  keys: string[];
  position: "left" | "right";
  image: string;
  url: string;
}*/

const { name, title, description, details, keys, position, image, url } =
  Astro.props;
---

<div
  class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center shadow-lg shadow-slate-700 overflow-hidden rounded-3xl p-8 md:p-10
h-full border-b-4 dark:border-sky-900 dark:shadow-sky-950 transition-transform
bg-gray-950"
>
  <div class="lg:col-span-4 flex flex-col justify-center space-y-4">
    <div>
      <p
        class="text-xs md:text-sm font-semibold uppercase tracking-widest text-amber-400"
      >
        {title}
      </p>
      <h4 class="text-white text-lg md:text-2xl font-bold mt-2">
        {name}
      </h4>
    </div>

    <div
      class="space-y-4 border-t border-slate-800 pt-4 text-slate-300 text-sm md:text-base leading-relaxed"
    >
      <p>
        {description}
      </p>
      {details && (
        <p>
          {details}
        </p>
      )}
    </div>
  </div>

  <!-- Columna Central: Captura de Laptop -->
  <div class="lg:col-span-5 flex justify-center items-center">
    <div class="w-full rounded-2xl overflow-hidden">
      <img
        src={image}
        alt={name}
        loading="lazy"
        class="w-full h-auto object-contain block"
      />
    </div>
  </div>

  <!-- Columna Derecha: Métricas y Tecnologías -->
  <div class="lg:col-span-3 flex flex-col justify-center space-y-6">
    <div class="pt-2 flex flex-col gap-y-2 items-center">
      <p class="text-sm font-medium text-slate-400 mt-1">
        Conoce más sobre estas soluciones
      </p>
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 w-60 py-4 bg-slate-800 hover:bg-slate-700/80 text-white font-medium text-sm rounded-xl border border-slate-700/50 transition-colors duration-300"
      >
        <span>Contacto</span>
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  /* Sin efectos de grid dinámicos ni patrones invasivos */
</style>
