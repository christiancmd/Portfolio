---
import Box from "../features/box.astro";

const { section, resume } = Astro.props;

const experiences = [
  {
    id: "ceinar",
    company: "Ceinar",
    logo: "/companies/ceinar.webp",
    role: "Backend Developer",
    period: "Junio 2026 — Julio 2026",
    description:
      "Organismo principal que agrupa a los profesionales de la ingeniería en el estado es el Centro de Ingenieros del Estado Aragua (CEINAR).",
    projects: [
      {
        category: "BACKEND DEVELOPER",
        title: "Desarrollador Backend",
        description: [
          "Desarrollo del backend para una plataforma de gestión de emergencias post-sísmicas, orientada a la respuesta técnica inmediata ante desastres por parte de ingenieros voluntarios.",
          "Apoyo prolongado en la auditoría del sistema y la migración de la base de datos.",
          "Uso de contenedores con Docker para garantizar un buen desarrollo en equipo..",
        ],

        metrics: [
          { label: "IMPACTO", value: "+200 Voluntarios" },
          { label: "Modalidad", value: "Híbrido" },
          {
            label: "Tecnologías",
            value: "Django Rest Framework, Docker, PostgreSQL, Excel",
          },
        ],
      },
    ],
  },
  {
    id: "sirius",
    company: "Sirius Tech SRL",
    logo: "/companies/sirius.webp",
    role: "Wordpress Developer",
    period: "Enero 2026 — Junio 2026",
    description:
      "Empresa de tecnología especializada en brindar soluciones integrales tanto para el sector residencial como empresarial en República Dominicana.",
    projects: [
      {
        category: "DISEÑO",
        title: "Wordpress Developer",
        description: [
          "Diseño en Wordpress a medida según requerimientos del cliente y necesidades del proyecto.",
          "Creación de página web mediante la integración de CMS, Plugins eficientes y Metodologías Ágiles.",
          "Optimización de la página web para SEO.",
        ],

        metrics: [
          { label: "IMPACTO", value: "+99% Social" },
          { label: "Modalidad", value: "Remoto" },
          { label: "Tecnologías", value: "Wordpress, Elementor, SEO" },
        ],
      },
    ],
  },
  {
    id: "sinergia",
    company: "Grupo Sinergia",
    logo: "/companies/sinergia.webp",
    role: "Fullstack Developer",
    period: "Febrero 2026 — Marzo 2026",
    description:
      "Conglomerado de expertos especializados en recuperación y adecuación de infraestructura para potenciar la producción de crudo y gas.",
    projects: [
      {
        category: "FULL-STACK",
        title: "Fullstack Developer",
        description: [
          "Liderazgo técnico en la planificación y desarrollo de una pagina web para el sector petrolero, priorizando el rendimiento en producción con Astro.js.",
          "Implemetación de servicio de correo electrónico eficiente.",
          "Optimización del flujo de trabajo mediante herramientas y agentes de IA, logrando un desarrollo de código más limpio, rápido y eficiente.",
        ],
        metrics: [
          { label: "Rendimiento", value: "100%" },
          { label: "Modalidad", value: "Remoto" },
          { label: "Tecnologías", value: "Astro.js, TypeScript, Tailwind CSS" },
        ],
      },
    ],
  },
  {
    id: "parisca",
    company: "PariscaNovedades C.A",
    logo: "/companies/parisca.webp",
    role: "Gestor Y Analista de Datos",
    period: "Agosto 2024 — Mayo 2025",
    description:
      "Distribuidora de ropa con las mejores marcas nacionales e importadas de Perú.",
    projects: [
      {
        category: "ANÁLISIS DE DATOS",
        title: "Gestor Y Analista de Datos",
        description: [
          "Migración integral de inventario físico a plataformas digitales (Excel), eliminando la dependencia de registros manuales.",
          "Diseño e implementación de un control de inventario para una manipulación segura y eficiente de los datos.",
          "Generación de reportes semanales de ventas y rendimiento de productos.",
        ],
        metrics: [
          { label: "EFICTIVIDAD", value: "+100 Productos" },
          { label: "Modalidad", value: "Remoto" },
          {
            label: "Tecnologías",
            value: "Excel, Google Sheets, Microsoft Office",
          },
        ],
      },
    ],
  },
];
---

<section
  id="experiences"
  class="w-full py-24 px-6 md:px-12 lg:px-24 bg-[#fcfcfc] dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto">
    <header
      class="flex justify-center items-center flex-col mb-30 text-center lg:text-left space-y-4"
    >
      <span
        class="block text-xs font-bold tracking-[0.2em] text-slate-500 uppercase"
      >
        {section || "TRAYECTORIA"}
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">
        Experiencia <span class="text-blue-600 dark:text-sky-800"
          >Profesional</span
        >
      </h2>
      {
        resume && (
          <p class="text-lg text-center md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
            {resume}.
          </p>
        )
      }
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-12 items-start">
      <!-- Sidebar Navigation -->
      <div class="relative w-full">
        <!-- Gradiente sutil para indicar que hay contenido a la derecha -->
        <div class="absolute right-0 top-0 bottom-4 w-12 bg-gradient-to-l from-[#fcfcfc] dark:from-slate-950 to-transparent pointer-events-none z-10 lg:hidden" />
        
        <nav class="flex flex-row lg:flex-col gap-3 overflow-x-auto pb-4 lg:pb-0 snap-x scrollbar-thin scroll-smooth shrink-0" aria-label="Selección de experiencia">
          {
            experiences.map((exp, index) => (
              <button
                class={`exp-item group relative p-4 md:p-6 text-left rounded-2xl transition-all duration-300 border border-slate-800 bg-slate-900 hover:bg-slate-900/95 [&.active-state]:border-blue-600 dark:[&.active-state]:border-blue-500 [&.active-state]:shadow-lg shrink-0 snap-start min-w-[240px] md:min-w-[280px] lg:min-w-0 flex-1 ${index === 0 ? "active-state" : ""}`}
                data-target={exp.id}
              >
                <div class="flex items-center gap-3">
                  <div class="shrink-0 w-9 h-9 bg-white border border-slate-200 dark:border-white/10 rounded-lg flex items-center justify-center overflow-hidden p-1 shadow-sm">
                    <img
                      src={exp.logo}
                      alt={exp.company}
                      class="w-full h-full object-contain"
                      loading="lazy"
                    />
                  </div>
                  <div class="space-y-0.5">
                    <span class="block text-[10px] font-semibold tracking-wider text-slate-400 uppercase">
                      {exp.period}
                    </span>
                    <h3 class="text-base md:text-lg font-bold text-slate-200 group-[.active-state]:text-blue-600 dark:group-[.active-state]:text-blue-450 transition-colors">
                      {exp.company}
                    </h3>
                    <p class="text-xs md:text-sm text-slate-300">
                      {exp.role}
                    </p>
                  </div>
                </div>
                <div
                  class="absolute right-4 top-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-blue-600 dark:bg-blue-500 rounded-full transition-opacity duration-300 opacity-0 group-[.active-state]:opacity-100"
                />
              </button>
            ))
          }
        </nav>
      </div>

      <!-- Content Area -->
      <main class="relative min-h-100">
        {
          experiences.map((exp, index) => (
            <div
              class={`content-item transition-all duration-500 transform ${index === 0 ? "opacity-100 translate-y-0 relative" : "opacity-0 translate-y-4 absolute inset-0 pointer-events-none"}`}
              id={`content-${exp.id}`}
            >
              <header class="flex items-center gap-6 mb-8 md:mb-12">
                <div class="shrink-0 w-14 h-14 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl flex items-center justify-center shadow-md overflow-hidden">
                  <img
                    src={exp.logo}
                    alt={exp.company}
                    class="w-full h-full object-contain p-1.5"
                    loading="lazy"
                  />
                </div>
                <div>
                  <h3 class="text-xl md:text-2xl font-bold text-slate-800 dark:text-white leading-none mb-2">
                    {exp.company}
                  </h3>
                  <p class="text-slate-600 dark:text-slate-400 max-w-xl text-sm md:text-base">
                    {exp.description}
                  </p>
                </div>
              </header>

              <div class="space-y-8">
                {exp.projects.map((project) => (
                  <article class="group bg-slate-900 rounded-[2rem] p-6 md:p-10 border-b-4 border-slate-600 dark:border-sky-900 shadow-2xl dark:shadow-sky-950 transition-all duration-300">
                    <div class="w-full">
                      <div class="space-y-6">
                        <header>
                          <h4 class="text-xl md:text-2xl font-bold text-slate-100">
                            {project.title}
                          </h4>
                        </header>

                        <ul class="list-disc list-outside ml-4 space-y-2 text-slate-300 leading-relaxed">
                          {Array.isArray(project.description) ? (
                            project.description.map((item) => (
                              <li class="text-sm md:text-base tracking-wide font-normal">
                                {item}
                              </li>
                            ))
                          ) : (
                            <li class="text-sm md:text-base">{project.description}</li>
                          )}
                        </ul>

                        <footer class="pt-6 border-t border-white/20 dark:border-slate-800/80 flex flex-wrap justify-between items-end gap-6">
                          <div class="flex gap-8 md:gap-10">
                            {project.metrics.map((metric) => (
                              <div class="space-y-1">
                                <span class="block text-[10px] font-bold text-slate-400 uppercase">
                                  {metric.label}
                                </span>
                                <span class="block text-sm md:text-lg font-semibold text-slate-100">
                                  {metric.value}
                                </span>
                              </div>
                            ))}
                          </div>
                        </footer>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))
        }
      </main>
    </div>

    <div>
      <Box />
    </div>
  </div>
</section>

<script>
  function initExperience() {
    const buttons = document.querySelectorAll(".exp-item");
    const contents = document.querySelectorAll(".content-item");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-target");

        // Update active button state
        buttons.forEach((b) => {
          b.classList.remove("active-state");
        });
        btn.classList.add("active-state");

        // Update active content with animation
        contents.forEach((content) => {
          if (content.id === `content-${target}`) {
            content.classList.remove(
              "opacity-0",
              "translate-y-4",
              "absolute",
              "pointer-events-none",
            );
            content.classList.add("opacity-100", "translate-y-0", "relative");
          } else {
            content.classList.remove(
              "opacity-100",
              "translate-y-0",
              "relative",
            );
            content.classList.add(
              "opacity-0",
              "translate-y-4",
              "absolute",
              "pointer-events-none",
            );
          }
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initExperience);
  initExperience();
</script>

<style>
  /* Barra de scroll sutil horizontal para tabletas y móviles */
  @media (max-width: 1023px) {
    nav::-webkit-scrollbar {
      height: 4px;
    }
    nav::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.03);
      border-radius: 999px;
    }
    :global(.dark) nav::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.03);
    }
    nav::-webkit-scrollbar-thumb {
      background: rgba(37, 99, 235, 0.2);
      border-radius: 999px;
    }
    :global(.dark) nav::-webkit-scrollbar-thumb {
      background: rgba(14, 165, 233, 0.2);
    }
  }

  .grid-pattern {
    background-size: 24px 24px;
    background-image:
      linear-gradient(to right, rgba(16, 185, 129, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(16, 185, 129, 0.08) 1px, transparent 1px);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes float-reverse {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  .animate-float {
    animation: float 5s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 5.5s ease-in-out infinite;
    animation-delay: 1.5s;
  }

  .animate-float-reverse {
    animation: float-reverse 6s ease-in-out infinite;
  }
</style>
