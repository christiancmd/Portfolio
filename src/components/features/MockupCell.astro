---
import Button from "../ui/Button.astro";

const { position, name, title, descriptioon, detail, keys, image, url } =
  Astro.props;
---

<div
  class={`group bg-gray-200 rounded-3xl overflow-hidden p-6 md:p-8 flex gap-6 md:gap-8 flex-col h-full border-b-4 border-slate-600  shadow-lg shadow-slate-700  dark:border-sky-900 dark:shadow-sky-950 transition-transform dark:bg-gray-950 hover:-translate-y-1 duration-200 timeline-view animate-blurred-fade-in animate-range-[entry_10%_contain_30%] ${
    position === "left"
      ? "flex-col md:flex-row"
      : "flex-col md:flex-row-reverse"
  }`}
>
  <!-- Mockup Celular (Lado Izquierdo) -->
  <div class="w-44 md:w-52 lg:w-70 shrink-0">
    <img
      src={image}
      alt={name}
      loading="lazy"
      class="w-full h-auto object-contain drop-shadow-2xl"
    />
  </div>

  <!-- Detalles del Proyecto -->
  <div class="w-full">
    <div class="space-y-3 mb-10 border-b border-slate-800 pb-6">
      <div>
        <p
          class="text-blue-900 text-xs md:text-sm font-semibold uppercase tracking-widest dark:text-amber-400"
        >
          {title}
        </p>
        <h4
          class="text-xl md:text-2xl font-bold text-slate-900 mt-2 group-hover:text-blue-900 dark:text-white dark:group-hover:text-amber-400 transition-colors duration-300"
        >
          {name}
        </h4>
      </div>

      <p class="text-slate-700 text-sm md:text-base dark:text-slate-300">
        {descriptioon}
      </p>

      <p class="text-slate-700 text-sm md:text-base dark:text-slate-300">
        {detail}
      </p>
    </div>

    <!-- <div class="flex flex-wrap gap-2 mt-6 pb-6 border-b border-slate-800">
      {
        keys.map((key: string) => (
          <span class="px-3 py-1.5 bg-slate-800/80 border border-slate-700/50 rounded-full text-xs font-semibold text-slate-300">
            {key}
          </span>
        ))
      }
    </div> -->

    <a
      href={url}
      rel="noopener noreferrer"
      target="_blank"
      class="w-full sm:w-auto"
    >
      <Button
        text="Ver Proyecto"
        color="text-white"
        bg="bg-slate-800 w-50 h-14 dark:bg-sky-800"
      />
    </a>
  </div>
</div>
